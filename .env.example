# Copy to .env and fill in. Never commit the filled file: .env is git-ignored.
#
# The whole pipeline runs offline. Every variable below is optional: the application starts
# and the full test suite passes with no API key and no model file present.

# --- Local model (primary path) -------------------------------------------------------
# Base URL of the running `llama-server` instance. See scripts/run_llama_server.sh.
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# Model identifier advertised by llama-server. It does not have to match a real file name.
LLAMA_MODEL=local-llm
# Seconds before a local request is abandoned and the caller falls back.
LLAMA_TIMEOUT_S=120

# --- Cloud providers (secondary, comparative axis only) -------------------------------
# Leave empty to disable. The extractor then silently uses the local model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- OCR -------------------------------------------------------------------------------
# easyocr | tesseract. Only one engine runs per request.
OCR_ENGINE=easyocr
EASYOCR_LANGS=pt,en
# Full path to the tesseract executable. Leave empty to search PATH (Linux, macOS) or the
# default install directory (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe).
TESSERACT_CMD=

# --- Paths -----------------------------------------------------------------------------
DATA_DIR=data
RECEIPTS_DIR=data/receipts
GROUND_TRUTH_PATH=data/ground_truth.csv
RESULTS_DIR=results
