# Copy to .env to override defaults. All variables below are optional:
# the application and test suite run completely offline with no .env present.

# --- Cloud Provider (Optional) --------------------------------------------------------
# Google Gemini API key. When left empty, the pipeline uses the local LLM exclusively.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# --- Local LLM & Server (Optional) ----------------------------------------------------
# Model launched by './run serve' (or 'run serve' on Windows).
# LLAMA_MODEL_PATH=models/Qwen2.5-Coder-3B-Instruct-Q4_K_M.gguf
# LLAMA_PORT=8080
# LLAMA_NGL=0      # Set to 99 if you have a GPU with >= 3 GB VRAM
# LLAMA_CTX=8192
# LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# LLAMA_TIMEOUT_S=120

# --- OCR Engine (Optional) -------------------------------------------------------------
# easyocr | tesseract. Default: easyocr.
# OCR_ENGINE=easyocr
# EASYOCR_LANGS=pt,en
# TESSERACT_CMD=   # Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Logging (Optional) ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Default: INFO.
# LOG_LEVEL=INFO

# --- Path Overrides (Optional - defaults shown) ---------------------------------------
# DATA_DIR=data
# RECEIPTS_DIR=data/receipts
# GROUND_TRUTH_PATH=data/ground_truth.csv
# RESULTS_DIR=results
